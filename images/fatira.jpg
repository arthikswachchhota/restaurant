      </div>


      <!-- JUICE -->
      <div class="card">

        <img src="images/fresh-juice.jpg"
             alt="Fresh Juice">

        <div class="card-body">

          <h3
            data-ar="عصيرات طازجة"
            data-en="Fresh Juice"
            data-bn="তাজা জুস">
            عصيرات طازجة
          </h3>

          <p
            data-ar="عصير طازج ومنعش"
