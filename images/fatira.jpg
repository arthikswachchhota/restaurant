      <div class="review">

        <div class="stars">⭐⭐⭐⭐⭐</div>

        <p
          data-ar="خدمة جميلة وطعام لذيذ."
          data-en="Great service and delicious food."
          data-bn="সুন্দর সার্ভিস ও সুস্বাদু খাবার।">
          خدمة جميلة وطعام لذيذ.
        </p>

      </div>


      <div class="review">

        <div class="stars">⭐⭐⭐⭐⭐</div>

        <p
          data-ar="مكان جميل لتناول وجبة سريعة."
          data-en="A nice place for a quick meal."
          data-bn="দ্রুত খাবারের জন্য সুন্দর জায়গা।">
          مكان جميل لتناول وجبة سريعة.
        </p>

      </div>

    </div>

    <p class="demo-note"
