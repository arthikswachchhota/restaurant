            data-bn="তাজা ও সতেজ জুস">
            عصير طازج ومنعش
          </p>

          <div class="price"
               data-ar="السعر عند الطلب"
               data-en="Price on request"
               data-bn="মূল্য জানতে যোগাযোগ করুন">
            السعر عند الطلب
