<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>فواز كافتيريا | Fawaz Cafeteria</title>

  <meta
    name="description"
    content="فواز كافتيريا في أم السلام، جدة — فطيرة، همبرجر، عصيرات طازجة وسندوتشات."
  >

  <style>
    :root {
      --dark: #111827;
      --dark-2: #1f2937;
      --cream: #fffaf0;
      --gold: #d4a017;
      --gold-light: #f3d477;
      --green: #15803d;
      --green-dark: #166534;
      --blue: #2563eb;
      --white: #ffffff;
      --gray: #6b7280;
      --light: #f3f4f6;
      --border: #e5e7eb;
      --shadow: 0 12px 35px rgba(0, 0, 0, 0.10);
      --radius: 18px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Tahoma, sans-serif;
      background: var(--cream);
      color: var(--dark);
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      display: block;
      width: 100%;
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    /* ================= HEADER ================= */

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(17, 24, 39, 0.97);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .nav {
      min-height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      color: var(--white);
      font-size: 1.4rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .logo span {
      color: var(--gold-light);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .nav-links a {
      color: #fff;
      font-size: 0.95rem;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .languages {
      display: flex;
      gap: 6px;
    }

    .language-btn {
      border: 1px solid rgba(255,255,255,0.3);
      background: transparent;
      color: white;
      padding: 6px 10px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.8rem;
    }

    .language-btn.active {
      background: var(--gold);
      color: #111;
      border-color: var(--gold);
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 520px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      background:
        linear-gradient(
          rgba(0, 0, 0, 0.62),
          rgba(0, 0, 0, 0.68)
        ),
        url("images/IMG_3745.jpeg") center/cover no-repeat;
      color: white;
    }

    .hero-content {
      width: min(800px, 92%);
      padding: 50px 20px;
    }

    .hero-badge {
      display: inline-block;
      padding: 8px 16px;
      border: 1px solid rgba(255,255,255,0.35);
      border-radius: 30px;
      background: rgba(255,255,255,0.08);
      margin-bottom: 20px;
      font-size: 0.9rem;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 6vw, 4.4rem);
      margin-bottom: 15px;
      line-height: 1.15;
    }

    .hero h1 span {
      color: var(--gold-light);
    }

    .hero p {
      max-width: 650px;
      margin: 0 auto 28px;
      font-size: 1.08rem;
      color: #f3f4f6;
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 22px;
      border-radius: 12px;
      font-weight: 700;
      transition: 0.3s;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-whatsapp {
      background: var(--green);
      color: white;
    }

    .btn-whatsapp:hover {
      background: var(--green-dark);
    }

    .btn-call {
      background: white;
      color: var(--dark);
    }

    .btn-call:hover {
      background: #f3f4f6;
    }

    .btn-map {
      background: var(--blue);
      color: white;
    }

    /* ================= SECTION ================= */

    section {
      padding: 80px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-heading .small {
      color: var(--gold);
      font-weight: 800;
      font-size: 0.9rem;
      margin-bottom: 8px;
    }

    .section-heading h2 {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      margin-bottom: 10px;
    }

    .section-heading p {
      color: var(--gray);
      max-width: 650px;
      margin: auto;
    }

    /* ================= MENU ================= */

    #menu {
      background: white;
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .menu-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: 0.3s;
    }

    .menu-card:hover {
      transform: translateY(-7px);
    }

    .menu-image {
      height: 260px;
      overflow: hidden;
      background: #eee;
    }

    .menu-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }

    .menu-card:hover .menu-image img {
      transform: scale(1.06);
    }

    .menu-content {
      padding: 22px;
    }

    .menu-price {
  margin-top: 8px;
  margin-bottom: 12px;
  color: var(--gold);
  font-size: 1.05rem;
  font-weight: 900;
}

    .menu-order {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 10px 15px;
      background: var(--green);
      color: white;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 700;
    }

    /* ================= ABOUT ================= */

    .about {
      background: var(--cream);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about-image {
      border-radius: 22px;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .about-image img {
      height: 420px;
      object-fit: cover;
    }

    .about-text h2 {
      font-size: 2.3rem;
      margin-bottom: 18px;
    }

    .about-text p {
      color: var(--gray);
      margin-bottom: 15px;
    }

    .about-list {
      list-style: none;
      margin-top: 20px;
    }

    .about-list li {
      margin-bottom: 12px;
      font-weight: 600;
    }

    .about-list li::before {
      content: "✓";
      color: var(--green);
      font-weight: 900;
      margin-left: 9px;
    }

    /* ================= LOCATION ================= */

    .location-section {
      background: #f8fafc;
    }

    .location-card {
      background: white;
      border-radius: 22px;
      padding: 35px;
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
      align-items: center;
    }

    .location-info h3 {
      font-size: 1.7rem;
      margin-bottom: 15px;
    }

    .location-info p {
      color: var(--gray);
      margin-bottom: 10px;
    }

    .map-box {
      min-height: 300px;
      border-radius: 18px;
      background:
        linear-gradient(
          rgba(17, 24, 39, 0.7),
          rgba(17, 24, 39, 0.7)
        ),
        url("images/IMG_3745.jpeg") center/cover;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 25px;
    }

    /* ================= REVIEWS ================= */

    .reviews {
      background: white;
    }

    .demo-note {
      max-width: 700px;
      margin: -20px auto 35px;
      padding: 12px 18px;
      border-radius: 10px;
      background: #fff7d6;
      border: 1px solid #f0d77a;
      text-align: center;
      color: #725c00;
      font-size: 0.9rem;
    }

    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .review-card {
      background: #fafafa;
      border: 1px solid var(--border);
      padding: 25px;
      border-radius: 16px;
    }

    .stars {
      color: var(--gold);
      margin-bottom: 12px;
      letter-spacing: 2px;
    }

    .review-card p {
      color: var(--gray);
      margin-bottom: 15px;
    }

    .review-name {
      font-weight: 800;
    }

    /* ================= CONTACT ================= */

    .contact {
      background: var(--dark);
      color: white;
    }

    .contact .section-heading p {
      color: #cbd5e1;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .contact-card {
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      border-radius: 18px;
      padding: 28px;
      text-align: center;
    }

    .contact-icon {
      font-size: 2rem;
      margin-bottom: 12px;
    }

    .contact-card h3 {
      margin-bottom: 8px;
    }

    .contact-card p {
      color: #cbd5e1;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #0b1120;
      color: #94a3b8;
      text-align: center;
      padding: 25px 15px;
      font-size: 0.9rem;
    }

    footer strong {
      color: white;
    }

    /* ================= LANGUAGE ================= */

    [data-lang] {
      display: none;
    }

    body.lang-ar [data-lang="ar"] {
      display: block;
    }

    body.lang-en [data-lang="en"] {
      display: block;
    }

    body.lang-bn [data-lang="bn"] {
      display: block;
    }

    .inline-lang {
      display: inline !important;
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 900px) {
      .nav {
        flex-wrap: wrap;
        padding: 12px 0;
      }

      .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        padding-bottom: 5px;
      }

      .menu-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .reviews-grid {
        grid-template-columns: 1fr;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .about-grid,
      .location-card {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      section {
        padding: 60px 0;
      }

      .nav {
        justify-content: center;
      }

      .logo {
        width: 100%;
        text-align: center;
      }

      .nav-links {
        gap: 13px;
        font-size: 0.85rem;
        overflow-x: auto;
      }

      .languages {
        justify-content: center;
      }

      .hero {
        min-height: 480px;
      }

      .hero h1 {
        font-size: 2.5rem;
      }

      .hero p {
        font-size: 0.95rem;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .hero-buttons .btn {
        width: 100%;
      }

      .menu-grid {
        grid-template-columns: 1fr;
      }

      .menu-image {
        height: 280px;
      }

      .about-image img {
        height: 300px;
      }

      .location-card {
        padding: 20px;
      }

      .map-box {
        min-height: 230px;
      }
    }
  </style>
</head>

<body class="lang-ar">

  <!-- ================= HEADER ================= -->

  <header>
    <div class="container nav">

      <a href="#" class="logo">
        فواز <span>كافتيريا</span>
      </a>

      <nav class="nav-links">
        <a href="#menu">
          <span data-lang="ar">القائمة</span>
          <span data-lang="en">Menu</span>
          <span data-lang="bn">মেনু</span>
        </a>

        <a href="#about">
          <span data-lang="ar">من نحن</span>
          <span data-lang="en">About</span>
          <span data-lang="bn">আমাদের সম্পর্কে</span>
        </a>

        <a href="#location">
          <span data-lang="ar">الموقع</span>
          <span data-lang="en">Location</span>
          <span data-lang="bn">লোকেশন</span>
        </a>

        <a href="#contact">
          <span data-lang="ar">اتصل بنا</span>
          <span data-lang="en">Contact</span>
          <span data-lang="bn">যোগাযোগ</span>
        </a>
      </nav>

      <div class="languages">
        <button class="language-btn active" onclick="setLanguage('ar')">العربية</button>
        <button class="language-btn" onclick="setLanguage('en')">English</button>
        <button class="language-btn" onclick="setLanguage('bn')">বাংলা</button>
      </div>

    </div>
  </header>


  <!-- ================= HERO ================= -->

  <section class="hero">

    <div class="hero-content">

      <div class="hero-badge">
        <span data-lang="ar">أم السلام • جدة</span>
        <span data-lang="en">Umm Al-Salam • Jeddah</span>
        <span data-lang="bn">উম্ম আল-সালাম • জেদ্দা</span>
      </div>

      <h1>
        <span data-lang="ar">فواز <span>كافتيريا</span></span>
        <span data-lang="en">Fawaz <span>Cafeteria</span></span>
        <span data-lang="bn">ফাওয়াজ <span>ক্যাফেটেরিয়া</span></span>
      </h1>

      <p>
        <span data-lang="ar">
          وجبات بسيطة، طازجة ولذيذة — نرحب بكم في فواز كافتيريا.
        </span>

        <span data-lang="en">
          Simple, fresh and delicious food — welcome to Fawaz Cafeteria.
        </span>

        <span data-lang="bn">
          সহজ, তাজা ও সুস্বাদু খাবার — ফাওয়াজ ক্যাফেটেরিয়াতে আপনাকে স্বাগতম।
        </span>
      </p>

      <div class="hero-buttons">

        <a
          class="btn btn-whatsapp"
          href="https://wa.me/966571638203"
          target="_blank"
        >
          <span>WhatsApp</span>
        </a>

        <a
          class="btn btn-call"
          href="tel:+966571638203"
        >
          <span data-lang="ar">اتصل الآن</span>
          <span data-lang="en">Call Now</span>
          <span data-lang="bn">এখন কল করুন</span>
        </a>

      </div>

    </div>

  </section>


  <!-- ================= MENU ================= -->

  <section id="menu">

    <div class="container">

      <div class="section-heading">

        <div class="small">
          <span data-lang="ar">قائمة الطعام</span>
          <span data-lang="en">OUR MENU</span>
          <span data-lang="bn">আমাদের মেনু</span>
        </div>

        <h2>
          <span data-lang="ar">ماذا تريد أن تأكل؟</span>
          <span data-lang="en">What would you like to eat?</span>
          <span data-lang="bn">আপনি কী খেতে চান?</span>
        </h2>

        <p>
          <span data-lang="ar">
            اختر وجبتك المفضلة وتواصل معنا عبر واتساب.
          </span>

          <span data-lang="en">
            Choose your favorite food and order through WhatsApp.
          </span>

          <span data-lang="bn">
            আপনার পছন্দের খাবার বেছে নিয়ে WhatsApp-এ অর্ডার করুন।
          </span>
        </p>

      </div>


      <div class="menu-grid">

  <!-- 1. HAMBURGER -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/IMG_3745.jpeg"
        alt="Hamburger"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">همبرجر</span>
        <span data-lang="en">Hamburger</span>
        <span data-lang="bn">হামবার্গার</span>
      </h3>

      <p>
        <span data-lang="ar">برجر لذيذ ومحضر بعناية.</span>
        <span data-lang="en">Delicious burger prepared with care.</span>
        <span data-lang="bn">যত্নের সাথে তৈরি সুস্বাদু হামবার্গার।</span>
      </p>

      <div class="menu-price">SAR 8</div>

      <a
        class="menu-order"
        href="https://wa.me/966571638203?text=I%20want%20to%20order%20a%20Hamburger"
        target="_blank"
      >
        WhatsApp
      </a>

    </div>

  </article>


  <!-- 2. FATIRA -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/IMG_3749.jpeg"
        alt="Fatira"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">فطيرة</span>
        <span data-lang="en">Fatira</span>
        <span data-lang="bn">ফাতিরা</span>
      </h3>

      <p>
        <span data-lang="ar">فطيرة طازجة ولذيذة.</span>
        <span data-lang="en">Fresh and delicious Fatira.</span>
        <span data-lang="bn">তাজা ও সুস্বাদু ফাতিরা।</span>
      </p>

      <div class="menu-price">SAR 5</div>

      <a
        class="menu-order"
        href="https://wa.me/966571638203?text=I%20want%20to%20order%20Fatira"
        target="_blank"
      >
        WhatsApp
      </a>

    </div>

  </article>


  <!-- 3. SANDWICH -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/IMG_3750.jpeg"
        alt="Sandwich"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">سندوتش</span>
        <span data-lang="en">Sandwich</span>
        <span data-lang="bn">স্যান্ডউইচ</span>
      </h3>

      <p>
        <span data-lang="ar">سندوتش طازج ومناسب لوجبة سريعة.</span>
        <span data-lang="en">Fresh sandwich, perfect for a quick meal.</span>
        <span data-lang="bn">তাজা স্যান্ডউইচ, দ্রুত খাবারের জন্য উপযুক্ত।</span>
      </p>

      <div class="menu-price">SAR 7</div>

      <a
        class="menu-order"
        href="https://wa.me/966571638203?text=I%20want%20to%20order%20a%20Sandwich"
        target="_blank"
      >
        WhatsApp
      </a>

    </div>

  </article>


  <!-- 4. FRESH JUICE -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/Snapseed.jpeg"
        alt="Fresh Juice"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">عصيرات طازجة</span>
        <span data-lang="en">Fresh Juice</span>
        <span data-lang="bn">তাজা জুস</span>
      </h3>

      <p>
        <span data-lang="ar">عصيرات طازجة ومنعشة.</span>
        <span data-lang="en">Fresh and refreshing juices.</span>
        <span data-lang="bn">তাজা ও সতেজ জুস।</span>
      </p>

      <div class="menu-price">SAR 6</div>

      <a
        class="menu-order"
        href="https://wa.me/966571638203?text=I%20want%20to%20order%20Fresh%20Juice"
        target="_blank"
      >
        WhatsApp
      </a>

    </div>

  </article>


  <!-- 5. BOILED EGG -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/IMG_3803.jpeg"
        alt="Boiled Egg"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">بيض مسلوق</span>
        <span data-lang="en">Boiled Egg</span>
        <span data-lang="bn">সিদ্ধ ডিম</span>
      </h3>

      <p>
        <span data-lang="ar">بيض مسلوق طازج.</span>
        <span data-lang="en">Fresh boiled egg.</span>
        <span data-lang="bn">তাজা সিদ্ধ ডিম।</span>
      </p>

      <div class="menu-price">SAR 2</div>

      <a
        class="menu-order"
        href="https://wa.me/966571638203?text=I%20want%20to%20order%20a%20Boiled%20Egg"
        target="_blank"
      >
        WhatsApp
      </a>

    </div>

  </article>


  <!-- 6. MILK TEA -->
  <article class="menu-card">

    <div class="menu-image">
      <img
        src="images/IMG_3802.jpeg"
        alt="Milk Tea"
      >
    </div>

    <div class="menu-content">

      <h3>
        <span data-lang="ar">شاي بالحليب</span>
        <span data-lang="en">Milk Tea</span>
        <span data-lang="bn">দুধ চা</span>
