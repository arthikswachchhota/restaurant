<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>فواز كافتيريا | Fawaz Cafeteria</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Tahoma, sans-serif;
      background: #fffaf5;
      color: #222;
      line-height: 1.6;
      direction: rtl;
    }

    header {
      background: #111;
      color: white;
      padding: 18px 5%;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .nav {
      max-width: 1200px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    .languages {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .languages button {
      border: none;
      background: #fff;
      color: #111;
      padding: 8px 13px;
      border-radius: 20px;
      cursor: pointer;
      font-weight: bold;
    }

    .languages button:hover {
      background: #f5a623;
      color: white;
    }

    .hero {
      min-height: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 60px 20px;
      background:
        linear-gradient(rgba(0,0,0,.58), rgba(0,0,0,.58)),
        url("images/hamburger.jpg") center/cover no-repeat;
    }

    .hero-content {
      max-width: 750px;
    }

    .hero h1 {
      font-size: clamp(38px, 7vw, 70px);
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 20px;
      margin-bottom: 25px;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      transition: .2s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .whatsapp {
      background: #25D366;
      color: white;
    }

    .call {
      background: #f5a623;
      color: white;
    }

    .map {
      background: #4285f4;
      color: white;
    }

    section {
      max-width: 1200px;
      margin: auto;
      padding: 70px 20px;
    }

    .section-title {
      text-align: center;
      font-size: 34px;
      margin-bottom: 35px;
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .card {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,.10);
      transition: .25s;
    }

    .card:hover {
      transform: translateY(-6px);
    }

    .card img {
      width: 100%;
      height: 210px;
      object-fit: cover;
      display: block;
    }

    .card-body {
      padding: 20px;
      text-align: center;
    }

    .card h3 {
      font-size: 24px;
      margin-bottom: 8px;
    }

    .card p {
      color: #777;
      margin-bottom: 15px;
    }

    .price {
      font-weight: bold;
      color: #e67e22;
      margin-bottom: 15px;
    }

    .order-btn {
      display: inline-block;
      background: #111;
      color: white;
      text-decoration: none;
      padding: 9px 18px;
      border-radius: 20px;
    }

    .about {
      background: #fff;
      border-radius: 25px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    .about p {
      max-width: 800px;
      margin: auto;
      font-size: 18px;
      color: #555;
    }

    .location-box {
      text-align: center;
      background: #f7eee5;
      border-radius: 25px;
      padding: 40px 20px;
    }

    .location-box p {
      margin-bottom: 20px;
      font-size: 18px;
    }

    .reviews {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .review {
      background: white;
      padding: 25px;
      border-radius: 18px;
      box-shadow: 0 5px 18px rgba(0,0,0,.08);
      text-align: center;
    }

    .stars {
      font-size: 22px;
      margin-bottom: 10px;
    }

    .demo-note {
      text-align: center;
      color: #888;
      margin-top: 20px;
      font-size: 14px;
    }

    .contact {
      text-align: center;
    }

    footer {
      background: #111;
      color: white;
      text-align: center;
      padding: 30px 20px;
    }

    footer p {
      margin: 5px;
    }

    body.ltr {
      direction: ltr;
    }

    body.ltr .card-body,
    body.ltr .about,
    body.ltr .location-box,
    body.ltr .contact {
      text-align: center;
    }

    @media (max-width: 900px) {
      .menu-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .reviews {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .nav {
        justify-content: center;
      }

      .logo {
        width: 100%;
        text-align: center;
      }

      .hero {
        min-height: 450px;
      }

      .menu-grid {
        grid-template-columns: 1fr;
      }

      .card img {
        height: 230px;
      }

      section {
        padding: 50px 15px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <div class="nav">

      <div class="logo"
           data-ar="فواز كافتيريا"
           data-en="Fawaz Cafeteria"
